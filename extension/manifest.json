{
  "manifest_version": 3,
  "name": "Ebb: calm tabs",
  "short_name": "Ebb",
  "version": "0.2.0",
  "description": "Tabs you leave alone quietly ebb away: unloaded, then shelved, then saved to a searchable Library. Nothing is lost.",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Ebb",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "omnibox": {
    "keyword": "ebb"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "unlimitedStorage",
    "alarms",
    "idle",
    "sessions",
    "webNavigation",
    "scripting",
    "sidePanel",
    "contextMenus",
    "favicon"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Open Ebb"
    },
    "keep-tab": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Keep this tab (Ebb won't tidy it for a week)"
    },
    "send-to-later": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Send this tab to Later"
    }
  }
}
